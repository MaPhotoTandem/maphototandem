# ─── Cloudflare R2 (stockage photos) ────────────────────────────────────────
R2_ACCOUNT_ID=ton_account_id
R2_ACCESS_KEY_ID=ton_access_key
R2_SECRET_ACCESS_KEY=ton_secret_key
R2_BUCKET_NAME=ma-photo-tandem
# URL publique de ton bucket R2 (ex: https://photos.maphotot.com)
R2_PUBLIC_URL=https://ton-domaine.r2.dev

# ─── Stripe (paiements) ──────────────────────────────────────────────────────
# Clés disponibles sur dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret du webhook (généré dans le dashboard Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Prix par photo (en cents CAD) ───────────────────────────────────────────
# 1500 = 15.00 $CAD
PHOTO_PRICE_CENTS=1500

# ─── Admin ───────────────────────────────────────────────────────────────────
# Mot de passe pour accéder à l'interface d'upload
ADMIN_PASSWORD=change_this_password

# ─── URL du site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
